# ============================================================
# TRACE-X ENVIRONMENT CONFIGURATION
# ============================================================

# Server Settings
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Local SQLite default for zero-setup local dev/testing:
DATABASE_URL=sqlite:///./trace_x.db
# Or Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth, DB & Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=evidence-files

# Gemini AI API
# Server-side only - Never exposed to frontend!
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Frontend environment variables (placed in frontend/.env when configured):
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
